# Copy to .env.local for local development. Never commit real values.

# Google AI Studio (https://aistudio.google.com/) — verify current model IDs in your account.
GOOGLE_API_KEY=replace_me
GOOGLE_CHAT_MODEL=replace_with_current_supported_flash_model_id
GOOGLE_EMBEDDING_MODEL=replace_with_available_embedding_model_id
# Optional: request a smaller embedding size if the model supports it (changing it requires a new collection).
# GOOGLE_EMBEDDING_DIMENSIONS=768

# Qdrant Cloud (https://cloud.qdrant.io/)
QDRANT_URL=https://your-cluster-endpoint
QDRANT_API_KEY=replace_me
QDRANT_COLLECTION=my_custom_agent_db

# PostgreSQL conversation memory (default). MEMORY_BACKEND=memory is for smoke tests only.
DATABASE_URL=postgresql://user:password@host:5432/database
MEMORY_BACKEND=postgres
# Set to true for hosted PostgreSQL that requires TLS.
# DATABASE_SSL=true

# Optional tuning (defaults shown)
# REQUEST_TIMEOUT_MS=45000        # 5000–55000, must stay below the 60s route limit
# MAX_HISTORY_MESSAGES=30         # conversation window sent to the model
# MAX_GRAPH_STEPS=12              # LangGraph recursion limit (runaway-loop guard)
# QDRANT_TOP_K=4
# QDRANT_SCORE_THRESHOLD=0.35
# EMBEDDING_CHUNK_SIZE=1000
# EMBEDDING_CHUNK_OVERLAP=120

# Optional: natural "real" Nova voice via Gemini text-to-speech (same GOOGLE_API_KEY).
# Check the current TTS model ID and its free-tier quota in AI Studio. Leave empty to use the browser voice.
# GOOGLE_TTS_MODEL=replace_with_current_gemini_tts_model_id
# GOOGLE_TTS_VOICE=Kore
# Optional: model that transcribes recorded voice in browsers without speech recognition (e.g. Brave).
# Defaults to GOOGLE_CHAT_MODEL; a fast "lite" Flash model is recommended.
# GOOGLE_STT_MODEL=replace_with_current_flash_lite_model_id
